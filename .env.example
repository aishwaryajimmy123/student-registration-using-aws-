# Copy this file to .env for local development.
# NEVER commit the real .env file. NEVER put real secrets in this example file.

# Flask
SECRET_KEY=<REPLACE_ME_with_a_random_secret>
FLASK_ENV=development
MAX_CONTENT_LENGTH=5242880

# Database (RDS MySQL) — do not commit real values
DB_HOST=<REPLACE_ME_rds_endpoint>
DB_PORT=3306
DB_USER=<REPLACE_ME_db_username>
DB_PASSWORD=<REPLACE_ME_db_password>
DB_NAME=studentdb

# S3 / AWS — no access keys here; EC2 uses its IAM instance role
S3_BUCKET_NAME=<REPLACE_ME_bucket_name>
AWS_REGION=<REPLACE_ME_aws_region>
PRESIGNED_URL_EXPIRY_SECONDS=3600
